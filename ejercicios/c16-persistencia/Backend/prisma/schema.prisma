generator client{
    provider= "prisma-client"
    output= "../src/generated/prisma"
}

datasource db{
    provider= "postgresql"
    url= env("DATABASE_URL")
}

model Libro {
  id         Int     @id @default(autoincrement())
  titulo     String
  autor      String        // por ahora, texto. La relación en C17
  precio     Int
  imagen     String
  disponible Boolean @default(true)
}

model Autor {
  id           Int    @id @default(autoincrement())
  nombre       String @unique
  nacionalidad String
}